      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "operands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object"
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "$ref": "#/$defs/effect"
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts_established": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts_invalidated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "terminator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
