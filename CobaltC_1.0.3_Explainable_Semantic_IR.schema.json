        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "origin_op": {
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "referent",
        "access",
        "lifetime",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "referent": {
          "type": "string"
        },
        "access": {
          "enum": [
            "SharedRead",
            "MutableExclusive"
          ]
        },
        "lifetime": {
          "type": "string"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "Active",
            "Suspended",
            "Expired"
          ]
        },
        "derived_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "referent",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "referent": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "lower_bound": {
          "type": "string"
        },
        "upper_bound": {
          "type": "string"
        },
        "status": {
          "enum": [
            "Live",
            "Ended"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "cleanupRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent",
        "defer_obligations",
        "destruction_places"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "defer_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defer"
          }
        },
        "destruction_places": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "defer": {
      "type": "object",
      "additionalProperties": false,
