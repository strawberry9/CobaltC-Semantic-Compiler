{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobaltc.example/schema/explainable-semantic-ir-1.0.0.json",
  "title": "CobaltC 1.0.3 Explainable Semantic IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "compilation",
    "source_files",
    "modules",
    "types",
    "symbols",
    "functions",
    "contracts",
    "rules",
    "diagnostics",
    "summary"
  ],
  "properties": {
    "format": {
      "$ref": "#/$defs/format"
    },
    "compilation": {
      "$ref": "#/$defs/compilation"
    },
    "source_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceFile"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_col": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_col": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "language",
        "language_publication"
      ],
      "properties": {
        "name": {
          "const": "CobaltC-Explainable-Semantic-IR"
        },
        "version": {
          "const": "1.0.0"
        },
        "language": {
          "const": "CobaltC"
        },
        "language_publication": {
          "const": "1.0.3"
        }
      }
    },
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "analysis_model"
      ],
      "properties": {
        "compiler": {
          "type": "object"
        },
        "result": {
          "enum": [
            "valid",
            "invalid",
            "incomplete"
          ]
        },
        "analysis_model": {
          "type": "string"
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "imports",
        "exports"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "return_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "copyable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "destructor": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "entry_block",
        "blocks",
        "places",
        "values",
        "capabilities",
        "lifetimes",
        "cleanup_regions",
        "unsafe_regions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "entry_block": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/place"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "lifetimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifetime"
          }
        },
        "cleanup_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cleanupRegion"
          }
        },
        "unsafe_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unsafeRegion"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operations",
        "terminator"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "terminator": {
          "$ref": "#/$defs/terminator"
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "ownership",
        "initialization",
        "mutability",
        "lifetime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "ownership": {
          "type": "string"
        },
        "initialization": {
          "type": "string"
        },
        "mutability": {
          "type": "string"
        },
        "nullability": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifetime": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
