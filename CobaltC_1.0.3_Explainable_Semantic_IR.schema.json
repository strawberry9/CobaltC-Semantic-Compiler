          ]
        },
        "concurrency_contract": {
          "type": [
            "object",
            "null"
          ]
        },
        "representation_contract": {
          "type": [
            "object",
            "null"
          ]
        },
        "safety_requirements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
