      "properties": {
        "id": {
          "type": "string"
        },
        "registration_order": {
          "type": "integer",
          "minimum": 0
        },
        "body_block": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_places": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "unsafeRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent",
        "obligations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "satisfied": {
          "type": "boolean"
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "borrows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifetimes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destruction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concurrency": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsafe": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abi": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "operands",
        "results",
        "preconditions",
        "postconditions",
        "effects",
        "rule_refs",
        "facts_established",
        "facts_invalidated"
