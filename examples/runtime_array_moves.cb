module runtime_array_moves;

fn take(i32 index) : i32 {
    mut i32[3] values = [10, 20, 30];
    i32 taken = move values[index];
    values = [40, 50, 60];
    return taken;
}

fn known_index() : i32 {
    i32[2] values = [7, 8];
    i32 selected = 0;
    i32 taken = move values[selected];
    return taken + values[1];
}
