module nested_runtime_indices;

struct Data { i32[2] values; i32 tag; }

fn update(i32 index, i32 item) : i32 {
    mut Data[2] data = [Data { values=[1,2],tag=3 },Data { values=[4,5],tag=6 }];
    data[index].values[item] = 7;
    return data[index].values[item];
}

fn borrow_column(i32 index) : i32 {
    mut Data[2] data = [Data { values=[1,2],tag=3 },Data { values=[4,5],tag=6 }];
    mut i32* selected = &mut data[index].values[0];
    data[index].values[1] = 9;
    return *selected;
}
