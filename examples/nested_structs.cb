module nested_structs;

struct Point {
    i32 x;
    i32 y;
}

struct Rectangle {
    Point start;
    Point end;
}

fn duplicate(Rectangle value) : Rectangle {
    return move value;
}

fn main() : i32 {
    mut Rectangle rectangle = Rectangle {
        start = Point { x = 1, y = 2 },
        end = Point { x = 3, y = 4 }
    };
    i32 taken = move rectangle.start.x;
    i32 saved = rectangle.end.y;
    rectangle.start.x = taken;
    mut Rectangle* pointer = &mut rectangle;
    mut i32* left = &mut pointer->start.x;
    mut i32* right = &mut pointer->end.x;
    *left = 7;
    *right = 9;
    Rectangle copied = duplicate(rectangle);
    return copied.start.x + saved;
}
