module temporary_array_moves;

struct Point { i32 x; i32 y; }

fn make_grid() : Point[2][2] {
    return [[Point { x=1,y=2 },Point { x=3,y=4 }],
            [Point { x=5,y=6 },Point { x=7,y=8 }]];
}

fn take(Point point) : i32 {
    return point.x;
}

fn keep(i32 value) : i32 {
    return value;
}

fn run(i32 row, i32 column) : i32 {
    return take(move make_grid()[row][column]);
}

fn run_field(i32 row, i32 column) : i32 {
    return keep(move make_grid()[row][column].x);
}
