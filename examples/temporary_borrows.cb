module temporary_borrows;

struct Point { i32 x; i32 y; }

fn make_values() : i32[2] {
    return [4,7];
}

fn make_point() : Point {
    return Point { x=2,y=3 };
}

fn read(i32* value) : i32 {
    return *value;
}

fn set(mut i32* value) {
    *value=9;
}

fn inspect(Point* point) : i32 {
    return point->x;
}

fn run(i32 index) : i32 {
    set(&mut make_point().x);
    i32 item=read(&make_values()[index]);
    return inspect(&make_point()) + item;
}
